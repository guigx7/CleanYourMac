    "perf.confirm.heavy.freeUpPurgeable": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Free Up Purgeable Space asks macOS to clear data it can rebuild, which can include local Time Machine snapshots (your backups on the backup disk aren't affected). The Mac may feel slower for a few minutes."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Liberar Espaço Purgável pede ao macOS para limpar dados que ele consegue refazer, o que pode incluir capturas locais do Time Machine (os backups no disco de backup não são afetados). O Mac pode ficar mais lento por alguns minutos."
          }
        }
      }
    },
    "perf.confirm.heavy.reindexSpotlight": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Reindex Spotlight rebuilds the search index from scratch. Searches will be incomplete until it finishes, which can take hours."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Reindexar o Spotlight refaz o índice de busca do zero. As buscas ficam incompletas até terminar, o que pode levar horas."
          }
        }
      }
    },
    "perf.confirm.heavy.title": {
      "extractionState": "manual",
