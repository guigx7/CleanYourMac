    "about.description": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "An open-source Mac cleaner made for study: Cleanup, Performance, Applications and Space Lens, with nothing removed before you review it."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Um limpador de Mac de código aberto feito para estudo: Limpeza, Desempenho, Aplicativos e Lupa de Espaço, sem remover nada antes de você revisar."
          }
        }
      }
    },
    "about.disclaimer": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Independent study project. Not affiliated with, endorsed by or connected to MacPaw or CleanMyMac. Provided \"as is\", without warranty."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Projeto independente de estudo. Sem relação, apoio ou vínculo com a MacPaw ou o CleanMyMac. Fornecido \"como está\", sem garantias."
          }
        }
      }
    },
