    "alert.iosLatest.confirm": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Remove anyway"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Remover mesmo assim"
          }
        }
      }
    },
    "alert.iosLatest.message": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Without the latest backup you won't be able to restore that device to its current state."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Sem o backup mais recente, não será possível restaurar o aparelho ao estado atual."
          }
        }
      }
    },
